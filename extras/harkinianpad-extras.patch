+// HarkinianPad extras: manual jump.
+// Starts the game's own jump action (the one used when running off a ledge), but only from
+// ordinary on-ground movement, so it cannot interrupt attacks, items, climbing, swimming,
+// cutscenes or any other special state.
+s32 Player_HPTryManualJump(PlayState* play, f32 jumpVelocity) {
+    Player* this;
+    LinkAnimationHeader* anim;
+    s16 yawDiff;
+
+    if (play == NULL) {
+        return false;
+    }
+
+    this = GET_PLAYER(play);
+
+    if ((this == NULL) || Player_InCsMode(play) || (this->actor.parent != NULL)) {
+        return false;
+    }
+
+    if (!(this->actor.bgCheckFlags & BGCHECKFLAG_GROUND)) {
+        return false;
+    }
+
+    if (this->stateFlags1 &
+        (PLAYER_STATE1_LOADING | PLAYER_STATE1_INPUT_DISABLED | PLAYER_STATE1_TALKING | PLAYER_STATE1_DEAD |
+         PLAYER_STATE1_READY_TO_FIRE | PLAYER_STATE1_GETTING_ITEM | PLAYER_STATE1_CARRYING_ACTOR |
+         PLAYER_STATE1_CHARGING_SPIN_ATTACK | PLAYER_STATE1_HANGING_OFF_LEDGE | PLAYER_STATE1_CLIMBING_LEDGE |
+         PLAYER_STATE1_JUMPING | PLAYER_STATE1_FREEFALL | PLAYER_STATE1_FIRST_PERSON | PLAYER_STATE1_CLIMBING_LADDER |
+         PLAYER_STATE1_SHIELDING | PLAYER_STATE1_ON_HORSE | PLAYER_STATE1_DAMAGED | PLAYER_STATE1_IN_WATER |
+         PLAYER_STATE1_IN_ITEM_CS | PLAYER_STATE1_IN_CUTSCENE | PLAYER_STATE1_FLOOR_DISABLED)) {
+        return false;
+    }
+
+    if (this->stateFlags2 &
+        (PLAYER_STATE2_CRAWLING | PLAYER_STATE2_PAUSE_MOST_UPDATING | PLAYER_STATE2_OCARINA_PLAYING)) {
+        return false;
+    }
+
+    // Standing, walking, running, turning and Z-target movement only.
+    if ((this->actionFunc != Player_Action_Idle) && (this->actionFunc != Player_Action_80842180) &&
+        (this->actionFunc != Player_Action_TurnInPlace) && (this->actionFunc != Player_Action_80840450) &&
+        (this->actionFunc != Player_Action_808407CC) && (this->actionFunc != Player_Action_80840DE4) &&
+        (this->actionFunc != Player_Action_808414F8) && (this->actionFunc != Player_Action_8084193C) &&
+        (this->actionFunc != Player_Action_8084227C) && (this->actionFunc != Player_Action_808423EC)) {
+        return false;
+    }
+
+    jumpVelocity = CLAMP(jumpVelocity, 3.0f, 10.0f);
+
+    yawDiff = this->yaw - this->actor.shape.rot.y;
